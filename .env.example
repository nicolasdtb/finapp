# ==========================================
# FinApp - Configuracoes de Ambiente e Senhas
# ==========================================
# Copie para .env e preencha. NUNCA commite o .env.
# Gere valores fortes com:  openssl rand -hex 32

# Banco de Dados PostgreSQL (nao e publicado no host)
DB_USER=finapp_user
DB_PASSWORD=troque_por_uma_senha_forte
DB_NAME=finapp

# Segredo usado para assinar os tokens de login (JWT)
JWT_SECRET=troque_por_um_segredo_aleatorio

# IP da VM na rede ZeroTier (o frontend so e publicado neste IP, porta 8443)
ZT_IP=172.23.x.x

# Backend API
PORT=3001
NODE_ENV=production
